; --- Personal overrides (examples; put these in your DATA-folder ---
; --- EdSharp.inix, not here, since upgrades replace this file) -----
; [Options]
; YieldEncoding=
; ViewLevels="brl:1 brf:1 docx:0"
; [Compiler Python]
; CompileCommand="py -3 "%Source%" 2>&1"
; IndentUnit="\t"

; ===== Compiler definitions ================================================
; One section per compiler, one named key per setting, values verbatim.
; Reviewed 26 August 2026 against what a default, machine-wide install of
; each language actually provides. Keys:
;   CompileCommand    the command Control+F5 runs; %Source%, %SourceLong%,
;                     %SourceDir%, %SourceRoot%, %ProgDir%, %NetDir% expand
;   JumpPosition      regular expression locating the error position; the
;                     first number in the match is the line, the next the
;                     column
;   AbbreviateOutput  regular expression for output to remove before
;                     speaking -- typically the tool's echo of your own path
;   NavigatePart      regular expression for the starts of parts, used by
;                     Go to Part and by Alt+PageUp and Alt+PageDown
;   QuotePrefix       the comment prefix, used to skip comments when moving
;                     by indentation
;   ExtensionDefault  default file extension for the compiler
;   IndentUnit        the indentation this language uses -- four spaces, two
;                     spaces, or \t -- applied to a document that has none of
;                     its own to detect
;   GoToEnvironment   the interactive shell Control+Shift+G opens; the
;                     special values %Snippet% and %CSharp% open EdSharp's
;                     own JScript and C# consoles, and an empty value means
;                     the language has no shell
; Every expression was traced against the tool's real message format.
;
; RETIRED 26 August 2026: VBScript. Microsoft has deprecated it and is
; removing it from Windows, so an entry promising to run it would stop
; working on machines as they update. Earlier retirements, on 24 August:
; Boo, Java, LaTeX, MinGW C++, Perl, PHP, PowerBASIC, Ruby, VB.NET --
; each either unmaintained or impossible to verify from here. Anyone who
; still uses one can add a [Compiler <name>] section to the EdSharp.inix
; in their DATA folder, which upgrades never overwrite.

[CompilerExtensions]
; Which compiler section owns a file, by its extension. EdSharp reads
; this when a document is opened or activated and makes that section the
; current one, so the compile command, the part navigation, the comment
; prefix, the indent unit and the snippet folder all describe the file
; you are actually in.
;
; Before 30 August 2026 the compiler was one setting for the whole
; program, changed only by Pick Compiler, Control+Shift+F5. With C#
; chosen, a Python file compiled with csc, Alt+PageDown navigated by C#
; parts, comments were quoted with two slashes and Alt+V offered C#
; snippets -- four things wrong at once, and the cure was to remember.
;
; An extension named here must have a [Compiler <name>] section behind
; it or nothing changes. An extension not named here changes nothing
; either, so a plain text file leaves the last choice alone. Pick
; Compiler still overrides, and setting FollowDocument to 0 in [Options]
; turns the whole arrangement off.
;
; js goes to JavaScript rather than JScript .NET, since node runs a .js
; file and jsc compiles one only when asked to.
;
; Add your own: pyw=Python claims another Python extension, and
; vue=HTML hands a framework file to the HTML settings.

atom="XML"
bas="Visual Basic .NET"
bat="Batch"
bib="LaTeX"
cjs="JavaScript"
cls="LaTeX"
cmd="Batch"
config="XML"
cs="C#"
csx="C#"
gemspec="Ruby"
geojson="JSON"
htm="HTML"
html="HTML"
inf="Inix"
ini="Inix"
inix="Inix"
jkm="JAWS Script"
js="JavaScript"
jsh="JAWS Script"
jsm="JAWS Script"
json="JSON"
jsonc="JSON"
jss="JAWS Script"
ltx="LaTeX"
markdown="Markdown"
md="Markdown"
mdown="Markdown"
mjs="JavaScript"
mkd="Markdown"
php="PHP"
php5="PHP"
phtml="PHP"
pl="Perl"
plx="Perl"
pm="Perl"
ps1="PowerShell"
psd1="PowerShell"
psm1="PowerShell"
py="Python"
pyi="Python"
pyw="Python"
rake="Ruby"
rb="Ruby"
rbw="Ruby"
resx="XML"
rss="XML"
sql="SQL"
sty="LaTeX"
svg="XML"
tex="LaTeX"
vb="Visual Basic .NET"
vbe="VBScript"
vbs="VBScript"
wsf="VBScript"
xhtml="HTML"
xml="XML"
xsd="XML"
xsl="XML"
xslt="XML"

[Compiler C#]
; csc reports "Program.cs(12,34): error CS1002: ; expected". The jump
; pattern is anchored on the parentheses so a "12,34" in the program's
; own output cannot hijack it. %NetDir% is the running .NET Framework
; directory, which every Windows carries, so no install is assumed.
; GoToEnvironment: %CSharp% opens EdSharp's own C# console, where the
; editor window and its text box are already in scope. Windows ships no
; C# interpreter, so each line is compiled by the same csc named above
; and loaded into EdSharp itself, which is what lets the code touch the
; live document. Anyone with the .NET SDK can point this at
; "dotnet-script" or at "csi.exe" from Visual Studio's Roslyn folder
; instead; %Snippet% opens the JScript console.
; IndentUnit: four spaces, the Microsoft C# convention.
CompileCommand="%NetDir%\csc.exe /nologo /platform:x64 "%Source%" 2>&1"
JumpPosition="\(\d+,\d+\)"
AbbreviateOutput="^.*?\.cs"
NavigatePart="^( |\t)*(public|private|protected|internal|static|class|namespace|void)\b"
QuotePrefix="//"
ExtensionDefault="cs"
Extensions="csx"
IndentUnit="    "
GoToEnvironment="%CSharp%"

[Compiler Python]
; Traceback: File "prog.py", line 12, in main -- and syntax errors use
; the same "line 12" form. AbbreviateOutput drops the File "path" prefix
; from every frame and the traceback banner, so the announcement starts
; at the line number rather than reading your own path aloud.
; GoToEnvironment: "python -i" opens the interpreter with the file
; already run, so its functions and variables are there to try; the bare
; name finds the official python.org build on the machine path.
; IndentUnit: four spaces, as PEP 8 asks -- EdSharp's own default is one
; tab, but a Python file shared with others should follow the language's
; convention, and the document's own indentation still wins over both.
CompileCommand="python "%Source%" 2>&1"
JumpPosition="line \d+"
AbbreviateOutput="(^[ \t]*File ".*?", )|(^Traceback \(most recent call last\):[ \t]*\r?\n)"
NavigatePart="^( |\t)*(async +)?(def|class) +\w+"
QuotePrefix="#"
ExtensionDefault="py"
Extensions="pyw pyi"
IndentUnit="    "
GoToEnvironment="python.exe -i "%SourceLong%""

[Compiler JavaScript]
; node prints the failing location as path:line for syntax errors and
; path:line:column inside stack frames; the pattern matches both.
; AbbreviateOutput drops Node's frames inside its own internals and the
; path prefixes, leaving the script name, line and column.
; GoToEnvironment: "node -i" is Node's own read-evaluate-print shell,
; installed with Node itself.
; IndentUnit: two spaces, the prevailing JavaScript convention.
CompileCommand="node "%SourceLong%" 2>&1"
JumpPosition=":\d+(:\d+)?"
AbbreviateOutput="(^[ \t]*at .*node:(internal|diagnostics_channel).*$)|(file:///.*/)|(^[A-Za-z]:\\.*\\)"
NavigatePart="^( |\t)*((async +)?function|class) +\w+"
QuotePrefix="//"
ExtensionDefault="js"
Extensions="mjs cjs"
IndentUnit="  "
GoToEnvironment="node.exe -i"

[Compiler PowerShell]
; Errors report "At C:\path\script.ps1:12 char:5", and AbbreviateOutput
; removes the path prefix, leaving the script name, line and character.
; -NoProfile keeps a personal profile from changing the result, and
; -ExecutionPolicy Bypass runs the file without altering machine policy.
; GoToEnvironment: powershell.exe with -NoExit runs the file and then
; leaves the console open, so the functions it defined can be called.
; Windows PowerShell 5.1 is used rather than pwsh because it is the one
; that ships with every Windows.
; IndentUnit: four spaces, the PowerShell style guide's choice.
CompileCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%SourceLong%" 2>&1"
JumpPosition=":\d+ char:\d+"
AbbreviateOutput="^At .*\\"
NavigatePart="^( |\t)*(function|class) +[\w-]+"
QuotePrefix="#"
ExtensionDefault="ps1"
Extensions="psm1 psd1"
IndentUnit="    "
GoToEnvironment="powershell.exe -NoExit -ExecutionPolicy Bypass -File "%SourceLong%""

[Compiler JAWS Script]
; scompile reports "line 12, column 5". The bare name finds the compiler
; because EdSharp puts the running JAWS folder on the path at startup,
; so it works for whatever JAWS version is installed.
; GoToEnvironment: JAWS script has no console interpreter, so this is
; left unset and the command reports that there is none.
; IndentUnit: one tab, as the JAWS script files themselves use.
CompileCommand="scompile.exe "%Source%" 2>&1"
JumpPosition="line \d+, column \d+"
AbbreviateOutput="((^Compiling .*?\.js.)|(file .*?,))"
NavigatePart="^( |\t)*(Function|Script) +\w+"
QuotePrefix=";"
ExtensionDefault="jss"
Extensions="jsm jsh jkm"
IndentUnit="\t"

[Compiler JScript .NET]
; jsc reports "prog.js(12,3) : error JS1002". This is the compiler that
; builds EdSharp.dll, so the references below are the ones EdSharp's own
; scripts expect.
; GoToEnvironment: %Snippet%, the JScript console built into EdSharp,
; where frm is the editor window and rtb its text box -- the same two
; objects a snippet receives, so a line tried there is a line that
; works in a snippet.
; IndentUnit: two spaces, as for JavaScript.
CompileCommand="%NetDir%\jsc.exe /nologo /r:%ProgDir%\EdSharp.dll;System.dll;System.Windows.Forms.dll;System.Drawing.dll;Accessibility.dll;Microsoft.VisualBasic.dll "%Source%" 2>&1"
JumpPosition="\(\d+,\d+\)"
AbbreviateOutput="^.*?\.js"
NavigatePart="^( |\t)*(function|class) +\w+"
QuotePrefix="//"
ExtensionDefault="js"
IndentUnit="  "
GoToEnvironment="%Snippet%"

[Compiler Visual Basic .NET]
; vbc.exe sits beside csc.exe in every Windows .NET Framework folder, so
; this needs nothing installed. Its errors read the same way csc's do,
; "Program.vb(12) : error BC30201: Expression expected", so the jump
; pattern is the parenthesised line number.
; IndentUnit: four spaces, the Visual Basic convention.
CompileCommand="%NetDir%\vbc.exe /nologo "%Source%" 2>&1"
JumpPosition="\(\d+\)"
AbbreviateOutput="^.*?\.vb"
NavigatePart="^( |\t)*(Public |Private |Protected |Friend )?(Partial )?(Sub|Function|Class|Module|Structure|Property|Enum|Interface) +\w+"
QuotePrefix="'"
ExtensionDefault="vb"
Extensions="bas"
IndentUnit="    "

[Compiler VBScript]
; Windows still runs VBScript through cscript, but there is no syntax
; check that does not also run the program, and running a script to find
; out whether it parses is not a check. So no compile command -- the
; value here is navigation and the right comment character.
; Separate from Visual Basic .NET on purpose: vbc.exe compiles .vb and
; cannot compile a .vbs, so one section could not serve both.
NavigatePart="^( |\t)*(Public |Private )?(Sub|Function|Class) +\w+"
QuotePrefix="'"
ExtensionDefault="vbs"
Extensions="wsf vbe"
IndentUnit="    "

[Compiler XML]
; Well-formedness by the XML reader Windows already has, through a small
; batch file in Convert so the quoting is settled in one place rather than
; fought with here. The reader reports the line and position of the first
; fault, which is what the jump pattern finds.
; NavigatePart steps element by element, at any depth.
CompileCommand=""%ProgDir%\configs\convert\checkXml.cmd" "%Source%" 2>&1"
JumpPosition="line \d+"
NavigatePart="^( |\t)*<[A-Za-z_]"
QuotePrefix="<!-- "
ExtensionDefault="xml"
Extensions="xsl xslt xsd rss atom svg config resx"
IndentUnit="  "

[Compiler JSON]
; Parsed by the same PowerShell every Windows carries, again through a
; batch file in Convert. A JSON fault has no reliable line number in the
; message, so no jump pattern is offered rather than one that misleads.
; NavigatePart finds the keys at the top level of an object.
CompileCommand=""%ProgDir%\configs\convert\checkJson.cmd" "%Source%" 2>&1"
NavigatePart="^  ?\"[^\"]+\" *:"
QuotePrefix="// "
ExtensionDefault="json"
Extensions="jsonc geojson"
IndentUnit="  "

[Compiler HTML]
; No compiler: a browser accepts almost anything, so there is nothing
; useful to report as an error. What there is instead is navigation --
; Alt+PageDown steps heading to heading and landmark to landmark, which
; is how a page is read rather than how it is written.
NavigatePart="<(h[1-6]|main|nav|header|footer|aside|section|article|form|table)\b"
QuotePrefix="<!-- "
ExtensionDefault="htm"
Extensions="html xhtml"
IndentUnit="  "

[Compiler Markdown]
; The checker for Markdown is the Check Markdown command, Alt+F9, which
; reports heading jumps, missing alt text, bare addresses, unclosed
; fences, uneven tables and diagram problems. So no compile command.
; NavigatePart steps heading to heading.
NavigatePart="^#{1,6} +\S"
QuotePrefix="> "
ExtensionDefault="md"
Extensions="markdown mdown mkd"
IndentUnit="  "

[Compiler Inix]
; Settings files, EdSharp's own format among them. Nothing to compile;
; the value is stepping section to section in a long file.
NavigatePart="^\["
QuotePrefix="; "
ExtensionDefault="inix"
Extensions="ini inf"
IndentUnit="  "

[Compiler Batch]
; The Windows command interpreter has no syntax check -- the only way to
; find out is to run it, which is not a check. NavigatePart steps label
; to label, which is how a batch file is structured.
NavigatePart="^:[A-Za-z_]"
QuotePrefix="rem "
ExtensionDefault="cmd"
Extensions="bat"
IndentUnit="  "

[Compiler SQL]
; No checker without a database to check against. NavigatePart steps
; statement to statement.
NavigatePart="^( |\t)*(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|WITH|BEGIN|COMMIT)\b"
QuotePrefix="-- "
ExtensionDefault="sql"
IndentUnit="  "

[Compiler LaTeX]
; Returned to the shipped table on 30 August 2026, having been retired on
; 24 August as not realistically relevant. It earns its place back for
; one reason: LaTeX is how accessible mathematics is written, and Pandoc
; now converts that mathematics to MathML, which a screen reader reads.
; The compile command needs MiKTeX; without it the command simply is not
; found, and the navigation and comment settings still work.
CompileCommand="pdflatex -halt-on-error -draftmode -interaction=nonstopmode "%Source%" 2>&1"
JumpPosition="line \d+"
NavigatePart="^\\(chapter|section|subsection|subsubsection|paragraph|begin\{(document|abstract|figure|table|equation)\})"
QuotePrefix="% "
ExtensionDefault="tex"
Extensions="ltx sty cls bib"
IndentUnit="  "

[Compiler Perl]
; perl -c checks syntax without running the program, which is the whole
; of what is wanted here. Needs Perl on the path; without it the command
; is not found and the other settings still work.
CompileCommand="perl -c "%Source%" 2>&1"
JumpPosition="line \d+"
NavigatePart="^( |\t)*(sub|package) +\w+"
QuotePrefix="#"
ExtensionDefault="pl"
Extensions="pm plx"
IndentUnit="    "

[Compiler PHP]
; php -l is the lint mode: syntax only, nothing run.
CompileCommand="php -l "%Source%" 2>&1"
JumpPosition="line \d+"
NavigatePart="^( |\t)*(abstract +|final +)?(public +|private +|protected +)?(static +)?(function|class|interface|trait) +\w+"
QuotePrefix="//"
ExtensionDefault="php"
Extensions="php5 phtml"
IndentUnit="    "

[Compiler Ruby]
; ruby -c checks syntax and prints "Syntax OK" when there is nothing to
; report.
CompileCommand="ruby -c "%Source%" 2>&1"
JumpPosition="line \d+"
NavigatePart="^( |\t)*(def|class|module) +\w+"
QuotePrefix="#"
ExtensionDefault="rb"
Extensions="rbw rake gemspec"
IndentUnit="  "

[Compiler Default]
; No compiler: plain writing and editing. The quote prefix is the one
; email uses, the extension is rich text, and the indentation is
; EdSharp's own single tab -- one keystroke to a level, one character to
; arrow across, and the level count is the character count.
QuotePrefix="> "
ExtensionDefault="rtf"
IndentUnit="\t"
GoToEnvironment="%Snippet%"
