tt2txt=pandoc "%SourceLong%" -f t2t -t plain -o %Target%
xls2csv=%ProgDir%\configs\convert\OfficeConvert\XlVert.exe "%SourceLong%" %Target%
xls2htm=%ProgDir%\configs\convert\any2htm.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
