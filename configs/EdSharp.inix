xlsx2txt=pandoc "%SourceLong%" -f xlsx -t plain -o %Target%
xlsx2md=pandoc "%SourceLong%" -f xlsx -t gfm -o %Target%
; Tombstones: an empty value disables and hides the entry everywhere,
; including stale copies in a user's old EdSharp.ini. hlp2txt and
