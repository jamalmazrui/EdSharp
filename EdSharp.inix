; PDF conversion goes one way for every target: pdf2md.cmd reads the
; PDF with the free PyMuPDF reader and writes RICH Markdown -- headings,
; lists, tables, emphasis -- and EdSharp turns that into HTML or plain
; text in the binary, or into a Word document with Pandoc. Nothing here
; needs Microsoft Word, and no target is a bare text dump.
pdf2htm=%ProgDir%\Convert\pdf2md.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
pdf2html=%ProgDir%\Convert\pdf2md.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
pdf2md=%ProgDir%\Convert\pdf2md.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
