htm2mw=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f html -t mediawiki -o %Target%
htm2rst=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f html -t rst -o %Target%
htm2tex=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f html -t latex -s -o %Target%
htm2tidy=%ProgDir%\Convert\Tidy\tidy.exe -config %ProgDir%\Convert\Tidy\tidy.cfg -o %Target% %Source%
htm2txt=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f html -t plain -o %Target%
