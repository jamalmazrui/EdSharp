; EdSharp.inix -- the SHIPPED configuration layer, read from the program
; folder. Entries here override the same [Section] Key in EdSharp.ini,
; and the installer refreshes this file on every upgrade -- so do not
; put personal settings here. For personal overrides, create an
; EdSharp.inix next to your EdSharp.ini in EdSharp's data folder; that
; user layer outranks this file, which outranks both .ini files.
;
; This file carries the conversion tables, modernized July 2026 for
; current Pandoc after a review found most entries failing:
;   * -S was removed in Pandoc 2.0; every entry drops it.
;   * markdown_github is deprecated; gfm is the current name.
;   * The txt2tags reader is named t2t, so the tt2 entries now work.
;   * There is no epub3 reader (epub reads EPUB 2 and 3); the old
;     epub32 entries are tombstoned below.
;   * --reference-docx became --reference-doc and is no longer passed
;     by default; to style docx output, create a reference document
;     and add, in your data-folder EdSharp.inix, a docx line ending
;     with: --reference-doc "%DataDir%\reference.docx"
;   * PDF targets use Pandoc's documented method (the .pdf output
;     extension selects PDF) and need a LaTeX engine like MiKTeX.
;   * brf2txt and brl2txt back-translate through liblouis via
;     Convert\liblouis\brl2txt.bat, replacing NFBTrans; edit that
;     batch file to change the braille language tables.
;   * htm2tidy and html2tidy use the new Convert\Tidy\tidy.cfg.
;   * New: odt2htm, odt2html, odt2md, odt2txt (Pandoc reads ODT) and
;     xlsx2md (needs a recent Pandoc 3.x with the xlsx reader).
; 2htm still serves doc, ppt, pptx, xls, and xlsx text extraction via
; any2txt.cmd; XlVert remains the only CSV producer.
;
; A key with an empty value below is a tombstone: it disables and
; hides an entry that an older user EdSharp.ini may still carry.
[Import]
brf2txt=%ProgDir%\Convert\liblouis\brl2txt.bat %ProgDir%\Convert\liblouis "%SourceLong%" %Target%
brl2txt=%ProgDir%\Convert\liblouis\brl2txt.bat %ProgDir%\Convert\liblouis "%SourceLong%" %Target%
doc2txt=%ProgDir%\Convert\any2txt.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
docx2htm=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t html -s -o %Target%
docx2html=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t html -s -o %Target%
docx2md=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t gfm -o %Target%
docx2mw=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t mediawiki -o %Target%
docx2rst=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t rst -o %Target%
docx2tex=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t latex -s -o %Target%
docx2txt=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f docx -t plain -o %Target%
epub2htm=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f epub -t html -s -o %Target%
epub2html=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f epub -t html -s -o %Target%
epub2md=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f epub -t gfm -o %Target%
epub2mw=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f epub -t mediawiki -o %Target%
epub2tex=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f epub -t latex -s -o %Target%
epub2txt=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f epub -t plain -o %Target%
