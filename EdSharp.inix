; Tombstones: hlp2txt and wpd2txt lost their reader when GetText
; retired; the epub32 entries never had a valid Pandoc reader.
epub32htm=
epub32html=
epub32md=
epub32mw=
epub32tex=
epub32txt=
hlp2txt=
wpd2txt=
