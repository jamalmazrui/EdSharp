pptx2txt=%ProgDir%\Convert\any2txt.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
rst2htm=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f rst -t html -s -o %Target%
rst2html=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f rst -t html -s -o %Target%
