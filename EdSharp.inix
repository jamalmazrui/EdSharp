; --- Personal overrides (examples; put these in your DATA-folder ---
; --- EdSharp.inix, not here, since upgrades replace this file) -----
; [Options]
; YieldEncoding=
; ViewLevels="brl:1 brf:1 docx:0"
; [Compiler C#]
; CompileCommand="csc.exe" /nologo "%SourceLong%" 2>&1
; JumpPosition=\(\d+,\d+\)

[Compilers]
; Overrides so the Compiler menu calls the .cmd scripts; the .bat
; versions are retired.
MinGW C++="%ProgDir%\Convert\MinGW.cmd %SourceDir%\%SourceRoot% 2>&1~:\d+:~^.*?\.cpp~^( |\t|\w)*((void)|(int)|(string)|(bool)|(DateTime)|(class))[^;]*?\{ *$~//~cs~%ProgDir%\ijs.exe"
PowerBASIC="%ProgDir%\Convert\pbw.cmd "%Source%" "%SourceDir%\%SourceRoot%.log" 2>&1~\(\d+\:\d+\)~(Power(.|\n)*?Reserved)|(Primary source:(.|\n)*)~^( |\t)*((Function)|(Sub)) +\w+~'~bas"

; ===== Compiler definitions (24 August 2026) ================================
; One section per compiler, one named key per setting, values verbatim.
; This replaces the tilde-packed [Compilers] values. Keys:
;   CompileCommand    the command Control+F5 runs; %Source%, %SourceLong%,
;                     %SourceDir%, %SourceRoot%, %ProgDir%, %NetDir% expand
;   JumpPosition      regular expression locating the error position in the
;                     output; the first number in the match is the line, the
;                     next number, when present, the column
;   AbbreviateOutput  regular expression for output text to condense before
;                     speaking
;   NavigatePart      regular expression for the starts of parts, used by
;                     Alt+PageUp and Alt+PageDown and Go to Part
;   QuotePrefix       the comment prefix, used to skip comments in
;                     indentation navigation and announcements
;   ExtensionDefault  default file extension for the compiler
;   GoToEnvironment   the interactive environment Control+Shift+G opens
; Every regular expression below was traced against the tool's real
; message format, noted beside it.

[Compiler C#]
; csc: "Program.cs(12,34): error CS1002: ; expected". The old jump
; pattern lacked the parentheses, so any "12,34" in program output
; could hijack the jump; anchored now.
CompileCommand="%NetDir%\csc.exe /nologo "%Source%" 2>&1"
JumpPosition="\(\d+,\d+\)"
AbbreviateOutput="^.*?\.cs"
NavigatePart="^( |\t)*(public|private|protected|internal|static|class|namespace|void)\b"
QuotePrefix="//"
ExtensionDefault="cs"
GoToEnvironment="%ProgDir%\ijs.exe"

[Compiler Python]
; Traceback: File "prog.py", line 12, in main -- and syntax errors use
; the same "line 12" form. NavigatePart now includes async def.
CompileCommand="python "%Source%" 2>&1"
JumpPosition="line \d+"
AbbreviateOutput="\r"
NavigatePart="^( |\t)*(async +)?(def|class) +\w+"
QuotePrefix="#"
ExtensionDefault="py"
GoToEnvironment="python.exe"

[Compiler JavaScript]
; node prints the failing location as path:line for syntax errors and
; path:line:column inside stack frames; the pattern matches both, so
; the jump lands on line and column when the column is given.
CompileCommand="node "%SourceLong%" 2>&1"
JumpPosition=":\d+(:\d+)?"
AbbreviateOutput="\r"
NavigatePart="^( |\t)*((async +)?function|class) +\w+"
QuotePrefix="//"
ExtensionDefault="js"
GoToEnvironment="node.exe"

[Compiler PowerShell]
; Errors report "At C:\path\script.ps1:12 char:5". The old command
; interpolated an undefined %file_name% variable; fixed to
; %SourceLong%, with profile loading and execution policy handled.
CompileCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%SourceLong%" 2>&1"
JumpPosition=":\d+ char:\d+"
AbbreviateOutput="\nAt .*?1:"
NavigatePart="^( |\t)*(function|class) +[\w-]+"
QuotePrefix="#"
ExtensionDefault="ps1"
GoToEnvironment="powershell.exe"

[Compiler JAWS Script]
; scompile reports "line 12, column 5". The old entry hardcoded the
; JAWS 12 installation path; EdSharp already puts the running JAWS
; folder on PATH at startup, so the bare name finds the compiler for
; whatever JAWS version is installed.
CompileCommand="scompile.exe "%Source%" 2>&1"
JumpPosition="line \d+, column \d+"
AbbreviateOutput="((^Compiling .*?\.js.)|(file .*?,))"
NavigatePart="^( |\t)*(Function|Script) +\w+"
QuotePrefix=";"
ExtensionDefault="jss"

[Compiler VBScript]
; cscript reports "script.vbs(12, 5) Microsoft VBScript ...". The old
; jump pattern \(\d+.*?\) also matched parenthesized program output;
; it now requires the line, comma, column shape.
CompileCommand="cscript.exe //nologo "%Source%" 2>&1"
JumpPosition="\(\d+, *\d+\)"
AbbreviateOutput="((^.*?\.vbs)|(Microsoft VBScript compilation error))"
NavigatePart="^( |\t)*(Function|Sub|Class) +\w+"
QuotePrefix="'"
ExtensionDefault="vbs"
GoToEnvironment="%ProgDir%\ijs.exe"

[Compiler JScript .NET]
; jsc reports "prog.js(12,3) : error JS1002". The old NavigatePart
; expression had an unbalanced parenthesis -- three closers after
; (function) -- so Go to Part threw an invalid-pattern exception the
; moment it was used with this compiler.
CompileCommand="%NetDir%\jsc.exe /nologo /r:%ProgDir%\EdSharp.dll;System.dll;System.Windows.Forms.dll;System.Drawing.dll;Accessibility.dll;Microsoft.VisualBasic.dll "%Source%" 2>&1"
JumpPosition="\(\d+,\d+\)"
AbbreviateOutput="^.*?\.js"
NavigatePart="^( |\t)*(function|class) +\w+"
QuotePrefix="//"
ExtensionDefault="js"
GoToEnvironment="%ProgDir%\ijs.exe"

[Compiler HTML Tidy]
; tidy reports "line 12 column 5 - Warning: ...".
CompileCommand="%ProgDir%\Convert\Tidy\tidy.exe -config %ProgDir%\Convert\Tidy\tidy.cfg -f %TempFile% %Source%"
JumpPosition="line \d+ column \d+"
AbbreviateOutput="\r"
NavigatePart="\n\n"
QuotePrefix="#"
ExtensionDefault="htm"

[Compiler Default]
QuotePrefix="> "
ExtensionDefault="rtf"
GoToEnvironment="%ProgDir%\ijs.exe"
