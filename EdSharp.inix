md2tex=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f gfm -t latex -s -o %Target%
md2txt=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f gfm -t plain -o %Target%
md2inix=%ProgDir%\Convert\inixVert.exe "%SourceLong%" %Target% /quiet
mdx2htm=%ProgDir%\Convert\mdx2htm.cmd "%ProgDirLong%" "%SourceLong%" "%TargetLong%"
mdx2md=%ProgDir%\Convert\inixVert.exe "%SourceLong%" %Target% /quiet
odt2htm=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f odt -t html -s -o %Target%
odt2html=%ProgDir%\Convert\Pandoc\pandoc.exe "%SourceLong%" -f odt -t html -s -o %Target%
