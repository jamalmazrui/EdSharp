<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <startup>
    <!-- Target the installed .NET Framework 4.x runtime. -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>

    <!--
      generatePublisherEvidence=false is a real launch-time win.  With it left on
      (the default), the CLR gathers Authenticode publisher evidence for the
      assembly at startup, which can involve a certificate-revocation check.  On a
      machine with no network, a slow DNS server, or a captive-portal Wi-Fi, that
      check blocks until it times out -- seconds of delay before the window even
      appears, and it varies from launch to launch, which is exactly what a
      "sometimes it takes longer than expected" startup feels like.  EdSharp does
      not use publisher-evidence-based security policy, so this is safe to turn
      off and there is no downside.
    -->
    <generatePublisherEvidence enabled="false" />

    <!--
      Background (concurrent) garbage collection.  Keeps GC pauses off the UI
      thread, which matters most for a text editor holding a large document.
    -->
    <gcConcurrent enabled="true" />

    <!--
      Do not probe the network for assembly binding.  Everything EdSharp loads
      lives beside the executable.
    -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="" />
    </assemblyBinding>

  </runtime>

</configuration>
