; accept.inix -- what "done" means for _APP_, written down before the code is.
;
; MODULE 1 OF THE METHOD IS "SPECIFY BEFORE YOU GENERATE", and this file is
; where that specification lands. Each [check] is one thing that must be true
; for the program to be finished, stated so a script can settle it rather than
; a person having to remember.
;
;   Name    what the check is for, in a few words
;   Run     a command, run in this folder
;   Expect  the exit code it must return; 0 unless you mean otherwise
;   Wants   optional: a string its output must contain
;
; That is the whole language, on purpose. A criterion nobody can read is a
; criterion nobody writes.
;
; scripts\check runs every one of these and records the command, the exit code
; and the verdict in the evidence report. A criterion that cannot be written
; this way is still worth writing -- put it in self.md under what a person has
; to check by hand, so it is not quietly forgotten.

FileTask = accept

; EdSharp is a windowed editor, not a command line tool, so its checks are
; about what the build produced and where. Each is a "dir /b" of one file:
; exit 0 when it exists, 1 when it does not, and no parentheses or
; redirection for the checker's quoting to trip on -- the first version
; used "cmd /c if exist X (exit 0) else (exit 1)" and every one failed
; with '" was unexpected at this time'.

[check]
Name = the program was built
Run = dir /b exec\EdSharp.exe
Expect = 0

[check]
Name = the installer was built
Run = dir /b exec\EdSharp_setup.exe
Expect = 0

[check]
Name = the JScript support assembly was built
Run = dir /b exec\EdSharp.dll
Expect = 0

[check]
Name = no copy of Lbc.cs is left in the folder
Run = dir /b Lbc.cs
Expect = 1

[check]
Name = no copy of Say.cs is left in the folder
Run = dir /b Say.cs
Expect = 1

[check]
Name = the conversion table is where the program looks for it
Run = dir /b configs\EdSharp.inix
Expect = 0

[check]
Name = the spelling dictionary is where the program looks for it
Run = dir /b data\dictionaries\en_US.dic
Expect = 0

[check]
Name = the screen reader scripts are where the installer ships them from
Run = dir /b scripts\jaws\EdSharp.JSS
Expect = 0

[check]
Name = the one binary the repository carries is present
Run = dir /b Tektosyne.dll
Expect = 0
